{
  "name": "sakha/cms-sdk",
  "description": "PHP SDK for Sakha MicroSite CMS - Complete API client library",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Sakha Global",
      "email": "dev@sakhaglobal.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Sakha\\CMS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sakha\\CMS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "phpcs": "phpcs --standard=PSR12 src/"
  }
}
